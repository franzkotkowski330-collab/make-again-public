# B07 明确的本地开发示例；复制为 .env 后先填写独立媒体签名密钥，再运行 preflight.py。
# 不要复制生产 .env 做测试，也不要把测试 DATABASE_URL 指向来源/生产数据库。
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/b07-development.sqlite3
STORAGE_LOCAL_DIR=./data/b07-development-uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 本地显式模拟所有外部网关；模拟通过不是供应商/真机联调通过。
MOCK_LLM=true
MOCK_WECHAT=true
MOCK_SPEECH=true
MOCK_VISION=true
MOCK_STORAGE=true

# 必填：使用 secrets.token_hex(32) 等安全方式生成自己的开发密钥，至少32字符。
# 留空时本地存储启动预检会拒绝；不要使用示例文字当成共享密钥。
# 此密钥用于本地媒体签名，也经用途派生用于分页游标签名；生产也可独立配置。
MEDIA_SIGNING_KEY=

# LLM 与微信登录；正式模式必须填写真实值，禁止缺配置自动走 mock。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-chat
LLM_REPORT_MODEL=
LLM_TIMEOUT=60
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TIMEOUT=10

# TTS/ASR；新用户语音回应默认关闭。API/worker 的 PATH 必须能找到已核实的 FFmpeg。
MAAS_BASE_URL=https://tokenhub.tencentmaas.com
MAAS_API_KEY=
TTS_MODEL=minimax-speech-2.8-hd
TTS_VOICE_ID=female-shaonv
ASR_MODEL=hy-asr-3.0-preview
SPEECH_TIMEOUT=120
SPEECH_MAX_UPLOAD_MB=20
ITEM_MAX_UPLOAD_MB=10

# 正式私有 COS；本地 mock_storage=true 时不使用这些凭据。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_PRESIGN_EXPIRES=600
COS_TIMEOUT=15
VISION_SECRET_ID=
VISION_SECRET_KEY=

# 保留旧配置名称，现表示开启树洞写信所需的已完成对话轮数；不靠更换session_id计数。
TREEHOLE_WRITE_SESSIONS=2

# 商户与获准平台未配置时保持不可售；没有默认/虚构套餐、金额、期限或自动续费。
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
PAYMENT_ALLOWED_PLATFORMS=

# 正式模板未提供时保持不可用；模板结构见 README，不在示例中编造模板ID/发送内容。
WECHAT_SUBSCRIBE_TEMPLATES=[]

# 正式部署核对（不要把以下要求理解为已配置或已上线）：
# 1. ENVIRONMENT=production，全部 MOCK_* 设 false。
# 2. DATABASE_URL 使用绝对 SQLite 文件路径；当前迁移器不支持 PostgreSQL。
# 3. PUBLIC_BASE_URL 必须 HTTPS，CORS_ORIGINS 只含实际获准来源，不能用 *。
# 4. 配齐真实 LLM/微信/MaaS/私有COS，密钥文件权限受控，不加入交付包。
# 5. API 与 --forever worker 使用同库/同配置；核实 FFmpeg PATH、备份与恢复后再启候选。
# 6. 支付商户/套餐/获准平台和提醒模板分别验收，缺失时相应能力继续关闭。
