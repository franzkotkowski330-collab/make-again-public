@import '../../assets/fonts/motto.wxss';
.collection-screen { padding: 20rpx 32rpx 50rpx; }
.collection-tabs { --td-tabs-item-height: 96rpx; --td-tabs-item-font-size: 28rpx; --td-tabs-track-width: 40rpx; }
.letter-list { margin-top: 36rpx; }
.empty-state { padding-top: 160rpx; }
.letter-arrival { position: fixed; inset: 0; z-index: 90; pointer-events: none; display: flex; align-items: center; justify-content: center; }
.arriving-paper { width: 640rpx; height: 78vh; max-width: 88vw; max-height: calc(100% - 100rpx); padding: 48rpx 38rpx; border-radius: 10rpx; border: 1rpx solid #E8E1EE; background: radial-gradient(ellipse at 50% 10%, #FFFDFF, #F7F4FA 88%); box-shadow: 0 26rpx 80rpx #81728F20; font-family: 'MAMottoWenKai', 'KaiTi', 'STKaiti', serif; color: #756A7E; text-align: center; transform-origin: center; }
.arriving-eyebrow { display: block; font-size: 22rpx; color: #9C8AA7; letter-spacing: 5rpx; }
.arriving-title { display: block; font-size: 42rpx; margin-top: 16rpx; }
.arriving-emblem { display: block; color: #A58DB5; margin: 24rpx 0 70rpx; }
.arriving-copy { display: block; font-size: 29rpx; line-height: 2; }
.arriving-sign { display: block; margin-top: 100rpx; font-size: 27rpx; color: #9C8AA7; }
.letter-placed { animation: letter-placed 1.3s ease-out; }
.placed-note { display: block; margin: 24rpx 12rpx; font-size: 23rpx; color: #9c8aa7; }
.chat-onboarding { position: fixed; inset: 0; z-index: 100; }
.chat-guide-scrim { position: absolute; inset: 0; background: rgba(61,49,75,.43); backdrop-filter: blur(2.5px); animation: chat-guide-fade .45s ease both; }
.chat-guide { position: absolute; bottom: calc(286rpx + env(safe-area-inset-bottom)); left: 36rpx; right: 36rpx; padding: 44rpx 46rpx 40rpx; border: 1rpx solid #FFF; border-radius: 46rpx; background: linear-gradient(145deg,#FFFEFD,#F7F2FA); box-shadow: 0 44rpx 106rpx #31233D48; color: #453851; line-height: 1.65; animation: chat-guide-rise .5s cubic-bezier(.19,1,.22,1) both; }
.chat-guide-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 36rpx; }
.chat-guide-kicker { font-size: 19rpx; color: #A38DAE; letter-spacing: .23em; font-weight: 700; }
.chat-guide-sparkle { font-family: Georgia,serif; font-size: 42rpx; line-height: 1; color: #C7B5D3; }
.chat-guide-title { margin: 0 0 16rpx; font-size: 44rpx; font-weight: 500; line-height: 1.45; letter-spacing: -.03em; }
.chat-guide-line { display: block; }
.chat-guide-copy { margin-bottom: 34rpx; font-size: 23rpx; line-height: 1.9; color: #908196; }
.chat-guide-button { display: flex; align-items: center; justify-content: center; gap: 23rpx; width: 100%; height: 96rpx; margin: 0; padding: 0 20rpx; border: 0; border-radius: 999rpx; background: #80708F; color: #FFF; font-family: inherit; font-size: 26rpx; font-weight: 500; line-height: 1.5; box-shadow: 0 23rpx 48rpx #745F8B40; }
.chat-guide-button::after,.chat-guide-tab::after { border: 0; }
.chat-guide-button[disabled] { color: #FFF; background: #80708F; opacity: .7; }
.chat-guide-arrow { font-size: 35rpx; line-height: 1; }
.chat-guide-hint { display: block; margin-top: 21rpx; font-size: 19rpx; color: #A697AF; text-align: center; }
.chat-guide-pointer { position: absolute; bottom: -76rpx; left: 33%; color: #FFF7FF; font-size: 66rpx; line-height: 1; text-shadow: 0 10rpx 25rpx #745E86AA; animation: chat-guide-bob 2s ease-in-out infinite; }
.chat-guide-tabs { position: absolute; bottom: 0; left: 0; right: 0; display: flex; height: calc(140rpx + env(safe-area-inset-bottom)); padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom)); background: #E9E4ED; border-top: 1rpx solid #E6E0EC; }
.chat-guide-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; width: 25%; margin: 0; padding: 0; border: 0; border-radius: 30rpx; background: transparent; color: #9E98A6; font: inherit; font-size: 21rpx; line-height: 1.4; overflow: visible; }
.chat-guide-tab image { width: 54rpx; height: 54rpx; }
.chat-guide-tab-muted { opacity: .4; }
.chat-guide-tab-current { color: #665273; font-weight: 600; }
.chat-guide-tab-chat { position: relative; color: #715E80; background: #FFFAFD; transform: translateY(-10rpx); box-shadow: 0 0 0 10rpx #FFFAFD,0 0 0 23rpx #E4D3F562,0 19rpx 48rpx #67517E50; animation: chat-guide-light .5s ease both; }
.chat-guide-tab-icon { width: 62rpx; height: 62rpx; border-radius: 21rpx; background: linear-gradient(140deg,#E9DCF6,#D3C2E4); display: flex; align-items: center; justify-content: center; }
@keyframes chat-guide-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes chat-guide-rise { from { opacity: 0; transform: translateY(38rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes chat-guide-bob { 50% { transform: translateY(12rpx); } }
@keyframes chat-guide-light { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .chat-guide,.chat-guide-scrim,.chat-guide-pointer,.chat-guide-tab-chat { animation: none; } }
@keyframes letter-placed { 0% { box-shadow: 0 0 0 0 #c7b3d06b; background: #f5eef8; } 60% { box-shadow: 0 0 0 18rpx #c7b3d000; } 100% { box-shadow: none; background: #fff; } }
