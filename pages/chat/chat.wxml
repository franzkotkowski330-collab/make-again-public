<view class="chat-screen" style="height: max(180px, calc(100vh - {{keyboardHeight}}px));">
  <view class="chat-top"><view><text class="chat-heading">聊天</text><text class="chat-subtitle">一个安心说话的角落</text></view><view class="chat-presence"><view class="presence-dot"></view><text>慢慢来，我在这里</text></view></view>
  <view wx:if="{{error}}" class="error chat-error"><text>{{error}}</text><button class="chat-text-button" bindtap="retry">重试</button></view>
  <scroll-view wx:if="{{!hasGuest}}" class="consent-scroll" scroll-y>
    <view class="consent-content"><view class="companion-orb consent-orb"><view class="orb-spark"></view></view><text class="consent-eyebrow">OUR FIRST CONVERSATION</text><text class="consent-title">你好，我们先认识一下。</text><text class="consent-summary">聊聊你的称呼、近况和陪伴期待，
一起建立一份属于你的个人档案。
每个问题都可以跳过，不着急。</text><view class="consent-note"><t-icon name="lock-on" size="25rpx"/><text>文字、语音与档案只保存在本机。清理缓存可能丢失；语音按原音保存，智能回复待开启。</text></view><button class="chat-primary accept-consent" bindtap="acceptConsent" disabled="{{saving}}">{{saving ? '正在准备…' : '同意并开始聊天'}}<text>→</text></button><view class="consent-links"><button class="chat-text-button" bindtap="readPrivacy">隐私说明</button><text>·</text><button class="chat-text-button" bindtap="declineConsent">稍后再说</button></view></view>
  </scroll-view>
  <block wx:else>
    <view class="chat-profile-strip"><view class="profile-strip-icon"><t-icon name="user-circle" size="35rpx"/></view><view class="profile-strip-main"><view class="profile-strip-heading"><text>{{guide ? '慢慢认识你' : '属于你的个人档案'}}</text><text class="profile-strip-count">{{completed}} / {{total}}</text></view><view class="profile-progress"><view style="width: {{progress}}%;"></view></view></view><button class="chat-text-button profile-strip-button" bindtap="viewProfile">查看档案<t-icon name="chevron-right" size="23rpx"/></button></view>
    <scroll-view class="message-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation bindtap="blurInput"><view class="message-content">
      <view class="chat-date"><view></view><text>{{dateLabel}}</text><view></view></view>
      <view wx:for="{{messages}}" wx:key="id" class="message-group {{item.role === 'user' ? 'from-user' : 'from-companion'}}" id="msg-{{item.id}}">
        <view wx:if="{{item.role !== 'user'}}" class="companion-orb"><view class="orb-spark"></view></view>
        <view class="message-main"><view class="message-bubble {{item.role === 'user' ? 'user-message' : 'companion-message'}}"><button wx:if="{{item.type === 'voice'}}" class="voice-message {{playingId === item.id ? 'is-playing' : ''}}" data-id="{{item.id}}" bindtap="playVoice" aria-label="{{playingId === item.id ? '停止播放语音' : '播放语音'}}"><t-icon name="{{playingId === item.id ? 'pause' : 'play'}}" size="30rpx"/><view class="voice-wave"><view></view><view></view><view></view><view></view><view></view><view></view><view></view><view></view><view></view></view><text>{{item.audio.duration}}″</text></button><text wx:else selectable>{{item.content}}</text></view><text wx:if="{{item.type === 'voice' && item.answerKey}}" class="voice-answer-note">语音回答已收进个人档案</text><text wx:if="{{item.role === 'user'}}" class="message-saved">{{item.timeLabel}} · 已保存</text></view>
        <view wx:if="{{item.role === 'user'}}" class="chat-user-avatar"><t-icon name="user" size="31rpx"/></view>
      </view>
      <view wx:if="{{quickReplies.length}}" class="quick-replies"><button wx:for="{{quickReplies}}" wx:key="*this" class="quick-reply" data-value="{{item}}" bindtap="quickReply" disabled="{{saving || recording || authorizing || audioSaving}}">{{item}}</button></view>
      <view wx:if="{{guide}}" class="guide-skip-row"><text>按你的节奏，随时可以补充</text><button class="chat-text-button" bindtap="skipQuestion" disabled="{{saving || recording || authorizing || audioSaving}}">这个问题先跳过<t-icon name="chevron-right" size="21rpx"/></button></view>
      <view class="scroll-tail"></view>
    </view></scroll-view>
    <view class="input-dock" style="padding-bottom: {{keyboardHeight ? '12rpx' : 'max(16rpx, env(safe-area-inset-bottom))'}};">
      <view wx:if="{{pendingAudio}}" class="audio-review"><view class="audio-review-title"><text>听一听，再发送</text><button class="chat-text-button" bindtap="discardAudio" disabled="{{audioSaving}}">重新录制</button></view><view class="audio-review-row"><button class="voice-message review-play {{playingId === 'pending' ? 'is-playing' : ''}}" data-id="pending" bindtap="playVoice"><t-icon name="{{playingId === 'pending' ? 'pause' : 'play'}}" size="30rpx"/><view class="voice-wave"><view></view><view></view><view></view><view></view><view></view><view></view><view></view></view><text>{{pendingAudio.duration}}″</text></button><button class="chat-primary audio-send" bindtap="sendAudio" disabled="{{audioSaving}}">{{audioSaving ? '保存中…' : '发送语音'}}</button></view><text class="audio-review-note">{{guide ? '这段原音将作为当前问题的回答保存' : '语音按原音保存在本机'}}，不会自动转成文字</text></view>
      <view wx:else class="input-row"><button class="mode-button" bindtap="toggleMode" aria-label="{{mode === 'text' ? '切换到语音输入' : '切换到文字输入'}}"><t-icon name="{{mode === 'text' ? 'microphone' : 'keyboard'}}" size="38rpx"/></button><textarea wx:if="{{mode === 'text'}}" class="chat-input" placeholder="{{placeholder}}" placeholder-class="input-placeholder" value="{{draft}}" maxlength="{{draftLimit}}" auto-height show-confirm-bar="{{false}}" adjust-position="{{false}}" cursor-spacing="20" bindinput="onInput" bindkeyboardheightchange="keyboardChange" disabled="{{saving}}"/><button wx:else class="hold-to-talk {{recording ? 'is-recording' : ''}} {{cancelRecording ? 'is-canceling' : ''}}" bindtouchstart="startRecording" catchtouchmove="moveRecording" bindtouchend="finishRecording" bindtouchcancel="cancelRecordGesture" disabled="{{saving}}">{{recording ? (cancelRecording ? '松开取消' : '松开完成录音') : (authorizing ? '正在准备麦克风…' : '按住说话')}}</button><button wx:if="{{mode === 'text'}}" class="send-button" bindtap="send" disabled="{{!canSend || saving}}" aria-label="发送文字"><t-icon name="arrow-up" size="34rpx"/></button></view>
      <text class="chat-input-note">{{mode === 'voice' ? '最长 60 秒 · 上滑取消 · 松开后可试听' : (guide ? '文字或语音都可以，每个回答都由你决定' : '内容保存在本机 · 智能回复待开启')}}</text>
    </view>
    <view wx:if="{{recording}}" class="recording-indicator {{cancelRecording ? 'cancel-indicator' : ''}}"><view class="recording-wave"><view></view><view></view><view></view><view></view><view></view></view><text class="recording-duration">{{recordSeconds}}″ / 60″</text><text>{{cancelRecording ? '松开手指，取消这段录音' : '正在听你说，松开后可以试听'}}</text></view>
  </block>
</view>
