@import '../../assets/fonts/motto.wxss';
.login-screen { height: 100vh; min-height: 100vh; padding: calc(env(safe-area-inset-top) + 90rpx) 40rpx calc(150rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: transparent; }
.login-hero { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 110rpx; }
.brand-name { display: flex; justify-content: center; align-items: baseline; gap: 8rpx; width: 100%; overflow: visible; font-family: 'MAParisienne', cursive; font-size: 118rpx; font-weight: 400; line-height: 1.6; color: #4C4555; }
/* Parisienne has negative side bearings. Padding keeps the flourishes inside the glimmer's text clip. */
.brand-word { display: inline-block; flex-shrink: 0; padding: 8rpx 12rpx; white-space: nowrap; letter-spacing: 0; overflow: visible; }
.brand-animate .brand-word { background: linear-gradient(105deg, #4C4555 12%, #4C4555 35%, #C6A789 51%, #4C4555 69%, #4C4555 89%); background-size: 300% 100%; background-position: 100% 0; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: brand-glimmer 1.8s ease-in-out both; }
.login-motto { display: block; margin-top: 38rpx; font-family: 'MAMottoWenKai', 'KaiTi', 'STKaiti', serif; font-size: 32rpx; font-weight: 400; line-height: 1.5; letter-spacing: 2.4rpx; color: #857D8D; white-space: nowrap; }
.motto-text { display: inline-block; }
.motto-animate .motto-text { animation: motto-reveal 1.8s both cubic-bezier(.23,.86,.29,.98); clip-path: inset(0 0 0 0); }
.login-footer { flex-shrink: 0; width: 100%; padding: 0 20rpx; }
.wechat-login { display: flex; align-items: center; justify-content: center; width: 100%; height: 96rpx; margin: 0; padding: 0 28rpx; border: 0; border-radius: 48rpx; background: #81728F; color: #FFFFFF; font-size: 30rpx; font-weight: 500; line-height: 1.5; }
.wechat-login::after { border: 0; }
.wechat-login-hover { background: #6D5E7B; }
.wechat-login[disabled] { background: #A497AE; color: #FFFFFF; }
.login-error { display: block; margin-bottom: 20rpx; text-align: center; color: #9A6378; font-size: 24rpx; line-height: 1.6; }
@keyframes brand-glimmer { 0% { opacity: 0; filter: blur(7px); background-position: 100% 0; } 24% { opacity: 1; filter: blur(0); } 100% { opacity: 1; background-position: 0% 0; filter: blur(0); } }
@keyframes motto-reveal { 0% { opacity: .08; clip-path: inset(0 100% 0 0); filter: blur(3px); } 85% { opacity: 1; filter: blur(0); } 100% { opacity: 1; clip-path: inset(0 0 0 0); filter: blur(0); } }
@media (prefers-reduced-motion: reduce) { .brand-animate .brand-word, .motto-animate .motto-text { animation-duration: .01ms; } }
