<view class="screen profile-screen">
  <view class="identity"><view class="avatar"><t-icon name="user" size="42rpx"/></view><view><text class="identity-name">游客</text><text class="identity-subtitle">{{hasGuest ? '本机记录' : '欢迎来到这里'}}</text></view></view>
  <view wx:if="{{error}}" class="error spaced">{{error}}</view>
  <view class="surface profile-settings">
    <t-cell wx:if="{{hasGuest}}" class="edit-profile" title="陪伴信息" left-icon="user-circle" arrow hover bind:click="editProfile"/>
    <t-cell wx:else title="开始旅程" left-icon="chat-bubble" arrow hover bind:click="startJourney"/>
    <t-cell class="settings-row" title="主创的信" left-icon="mail" arrow hover bind:click="readLetter"/>
    <t-cell class="privacy-row" title="隐私说明" left-icon="lock-on" arrow hover bind:click="readPrivacy"/>
    <t-cell class="wechat-login" title="微信登录" left-icon="login" arrow hover bind:click="openLogin"/>
  </view>
  <t-dialog visible="{{loginNotice}}" title="微信登录" content="微信账号登录尚未开通。你可以继续以游客身份使用，记录会保存在本机。" confirm-btn="知道了" bind:confirm="closeLoginNotice" bind:close="closeLoginNotice"/>
</view>
