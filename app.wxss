@import './assets/fonts/brand.wxss';
page { background: radial-gradient(ellipse 58% 44% at 50% 50%, rgba(188,215,250,.45), transparent 70%), radial-gradient(ellipse 52% 40% at 50% 50%, rgba(250,220,234,.4), transparent 70%), radial-gradient(ellipse 48% 38% at 50% 50%, rgba(222,201,250,.32), transparent 70%), #F8FAFF; background-repeat: no-repeat; background-size: 220% 220%, 200% 200%, 190% 190%, auto; animation: ma-bg-flow 6s ease-in-out infinite alternate; color: #35333D; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 28rpx; line-height: 1.65;
--td-brand-color: #81728F; --td-brand-color-active: #6D5E7B; --td-brand-color-light: #F0EDF5; --td-brand-color-disabled: #CEC7D7;
--td-text-color-primary: #35333D; --td-text-color-secondary: #86828E; --td-bg-color-container: #FFFFFF; --td-bg-color-component: #F2F1F5;
--td-component-border: #EBE9F0; --td-cell-border-color: #EFEDF3; --td-cell-vertical-padding: 30rpx; --td-cell-horizontal-padding: 32rpx;
--td-cell-title-font-size: 28rpx; --td-cell-description-font-size: 23rpx; --td-cell-note-font-size: 24rpx; --td-cell-note-color: #938A9D;
--td-button-large-font: 500 30rpx / 46rpx -apple-system, 'PingFang SC', sans-serif; --td-button-medium-font: 500 28rpx / 42rpx -apple-system, 'PingFang SC', sans-serif;
--td-button-border-radius: 22rpx; --td-tabs-bg-color: transparent; --td-tabs-item-color: #92909B; --td-tabs-item-active-color: #746786; --td-tabs-track-color: #8D7D9A;
--td-empty-description-color: #A39BAF; --td-empty-icon-color: #C8BED2; --td-empty-icon-size: 76rpx; }
view, text, button, input, textarea { box-sizing: border-box; }
@keyframes ma-bg-flow { 0% { background-position: 62% 18%, 30% 68%, 66% 88%, center; } 50% { background-position: 34% 42%, 70% 44%, 38% 60%, center; } 100% { background-position: 56% 72%, 62% 30%, 70% 72%, center; } }
@media (prefers-reduced-motion: reduce) { page { animation: none; } }
.screen { min-height: 100vh; padding: 44rpx 36rpx 56rpx; background: transparent; }
.page-title { display: block; font-size: 44rpx; font-weight: 600; color: #35333D; line-height: 1.4; letter-spacing: -1rpx; }
.page-caption { display: block; color: #94909B; font-size: 25rpx; margin-top: 12rpx; }
.section-label { display: block; color: #9993A3; font-size: 23rpx; margin: 36rpx 0 16rpx; }
.surface { background: #FFFFFF; border-radius: 24rpx; overflow: hidden; }
.spaced { margin-top: 28rpx; }
.error { padding: 20rpx 24rpx; color: #9A6378; background: #FBF0F4; border-radius: 16rpx; font-size: 24rpx; }
.muted { color: #98929E; font-size: 24rpx; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.body { display: block; color: #7D7786; font-size: 26rpx; line-height: 1.9; }
.heading { display: block; font-size: 40rpx; font-weight: 600; line-height: 1.5; color: #35333D; }
.lead { display: block; font-size: 25rpx; color: #92909B; line-height: 1.8; margin-top: 12rpx; }
.card { background: #FFF; border-radius: 24rpx; padding: 32rpx; }
.section-title { display: block; font-size: 29rpx; font-weight: 500; color: #49434F; }
.notice { font-size: 23rpx; line-height: 1.8; color: #9992A0; }
.text-button { background: transparent; color: #81728F; border: 0; font-size: 24rpx; }
.text-button::after { border: 0; }
.footnote { display: block; margin-top: 32rpx; color: #A49DAC; font-size: 21rpx; text-align: center; }
